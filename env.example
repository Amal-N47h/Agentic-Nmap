# Targets you own or have WRITTEN permission to scan (comma-separated IPs, CIDRs, hostnames)
ALLOWED_TARGETS=scanme.nmap.org

# Set at least one key. Priority: Anthropic > Groq > Gemini > local Ollama (no key)
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional
# PROVIDER=groq          # anthropic | groq | gemini | ollama
# MODEL=                 # override the provider's default model
# MAX_STEPS=10
